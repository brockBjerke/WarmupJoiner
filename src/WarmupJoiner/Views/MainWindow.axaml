<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WarmupJoiner.ViewModels"
        x:Class="WarmupJoiner.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="WarmupJoiner"
        Width="560" Height="760"
        MinWidth="460" MinHeight="560">

  <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="WarmupJoiner" FontSize="22" FontWeight="Bold" />
      <TextBlock Text="Unofficial companion app for warmupserver.net - finds a server matching your preferences and connects you automatically."
                 TextWrapping="Wrap" Opacity="0.7" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,0,0,12">
      <StackPanel Spacing="12">

        <StackPanel Spacing="8">
          <CheckBox Content="Exclude servers that currently have bots" IsChecked="{Binding ExcludeServersWithBots}" />

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="Min. human players" FontSize="12" Opacity="0.7" />
              <TextBox Text="{Binding MinHumanPlayersText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="Re-check every (s)" FontSize="12" Opacity="0.7" />
              <TextBox Text="{Binding PollIntervalSecondsText}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2">
              <TextBlock Text="Give up after (s, 0 = never)" FontSize="12" Opacity="0.7" />
              <TextBox Text="{Binding SearchTimeoutSecondsText}" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Regions &amp; cities (none selected = any)" FontSize="12" Opacity="0.7" />
          <ItemsControl ItemsSource="{Binding LocationGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RegionGroupViewModel">
                <StackPanel Margin="0,0,0,6">
                  <CheckBox IsThreeState="True" IsChecked="{Binding IsSelected}" Content="{Binding Name}" FontWeight="Bold" />
                  <ItemsControl ItemsSource="{Binding Cities}" Margin="22,0,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CityOption">
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,12,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Game modes (none selected = any)" FontSize="12" Opacity="0.7" />
          <ItemsControl ItemsSource="{Binding GameModes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ModeOption">
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,12,4" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="2" Content="{Binding ActionButtonText}" Command="{Binding StartStopCommand}"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,12" FontSize="16"
            Margin="0,0,0,12" />

    <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Height="160">
      <ScrollViewer>
        <TextBox Text="{Binding StatusText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 BorderThickness="0" FontFamily="Consolas,Menlo,monospace" FontSize="12" Padding="8" />
      </ScrollViewer>
    </Border>

  </Grid>
</Window>
